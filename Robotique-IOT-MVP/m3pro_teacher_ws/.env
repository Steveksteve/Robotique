# M3 Pro Teacher Workspace - Docker Environment Variables

# ROS Configuration
ROS_DOMAIN_ID=30
ROS_DISTRO=humble
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Network Configuration
DOCKER_NETWORK=m3pro_network

# Service Ports
ROSBRIDGE_PORT=9090
DASHBOARD_PORT=8080

# Image Configuration
IMAGE_NAME=m3pro_teacher_ws
IMAGE_TAG=humble
REGISTRY=

# Workspace Paths (inside container)
ROS_WS=/root/m3pro_teacher_ws
ROS_WS_SRC=/root/m3pro_teacher_ws/src
ROS_WS_INSTALL=/root/m3pro_teacher_ws/install

# Robot Configuration (for Jetson deployment)
JETSON_HOST=10.10.221.123
JETSON_USER=jetson
JETSON_WS_PATH=/home/jetson/m3pro_teacher_ws

# Dashboard Configuration
DASHBOARD_TITLE=M3 Pro Robot Dashboard
DASHBOARD_UPDATE_RATE=50  # ms between updates

# RosBridge Configuration
ROSBRIDGE_PORT=9090
ROSBRIDGE_FRAGMENTATION_SIZE=131072
ROSBRIDGE_DELAY_IN_MILLISECONDS=0

# Logging
LOG_LEVEL=INFO
DOCKER_COMPOSE_LOG=  # empty = normal, 'true' = debug logs
